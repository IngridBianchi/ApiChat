NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/chat
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
